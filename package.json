{
  "name": "lanes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "test": "node --test --disable-warning=ExperimentalWarning \"server/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
